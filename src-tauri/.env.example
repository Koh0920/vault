# BYOK Encrypted R2 Drop
# Copy to .env for local development.
# This sample now assumes Tauri + rclone sidecar + RC API.

# ------------------------------------------------------------------
# Frontend / Vite
# ------------------------------------------------------------------

# Display name in the desktop UI
VITE_APP_NAME=Encrypted R2 Drop

# Maximum single-file size: 10 GiB
VITE_MAX_FILE_SIZE_BYTES=10737418240

# Poll interval for job status in milliseconds
VITE_JOB_POLL_INTERVAL_MS=1000

# ------------------------------------------------------------------
# Tauri backend
# ------------------------------------------------------------------

# App-specific rclone config path
APP_RCLONE_CONFIG_PATH=

# App-specific local state path for jobs / logs
APP_STATE_DIR=

# Whether to use OS keychain for crypt secrets
APP_USE_KEYCHAIN=true

# Optional fallback crypt password when keychain is empty
APP_CRYPT_PASSWORD=

# ------------------------------------------------------------------
# rclone sidecar / RC API
# ------------------------------------------------------------------

# Sidecar binary name bundled by Tauri
RCLONE_SIDECAR_NAME=rclone

# RC listen address
RCLONE_RC_ADDR=127.0.0.1:5572

# RC username
RCLONE_RC_USER=local-user

# RC password
RCLONE_RC_PASS=change-me

# Retries for transfer operations
RCLONE_RETRIES=3

# Low-level retries for provider/network flakiness
RCLONE_LOW_LEVEL_RETRIES=10

# Default transfer mode: copy or sync
RCLONE_DEFAULT_MODE=copy

# ------------------------------------------------------------------
# Optional provider defaults
# ------------------------------------------------------------------

# Default Google Drive remote name
DEFAULT_GDRIVE_REMOTE=drive

# Google OAuth app for localhost desktop callback
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_CALLBACK_PORT=53682
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive

# Default R2 remote name
DEFAULT_R2_REMOTE=r2

# Default crypt remote suffix
DEFAULT_CRYPT_REMOTE_SUFFIX=-crypt

# ------------------------------------------------------------------
# Optional R2 bootstrap values for `connectProvider("r2")`
# ------------------------------------------------------------------

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
