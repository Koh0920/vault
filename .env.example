# Vault — standalone web server
# Copy to .env for local development (server loads it via dotenvy when run from server/).

# Listen address / port
VAULT_LISTEN_ADDR=0.0.0.0:8080

# Directory containing the built frontend (vite build output)
VAULT_FRONTEND_DIR=../frontend/dist

# Persistent state (rclone config, vault metadata) and temp upload dir
VAULT_STATE_DIR=./server/vault-data
VAULT_TEMP_DIR=./server/vault-data/tmp

# rclone binary (must be installed and on PATH, or point to an absolute path)
RCLONE_BINARY=rclone

# Google OAuth app (used for the rclone drive remote)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/drive/oauth/callback

# Secret used to sign session cookies (generate a long random value)
VAULT_COOKIE_SECRET=change-me-please-use-a-long-random-value