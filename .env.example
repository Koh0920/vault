# Vault — standalone web server
# Copy to .env for local development (server loads it via dotenvy when run from server/).

# Listen address / port. When not bound to loopback, VAULT_COOKIE_SECRET is
# mandatory (the server refuses the insecure dev default).
VAULT_LISTEN_ADDR=0.0.0.0:8080

# Directory containing the built frontend (vite build output)
VAULT_FRONTEND_DIR=../frontend/dist

# Persistent state (per-session rclone configs, vault metadata) and temp upload dir
VAULT_STATE_DIR=./server/vault-data
VAULT_TEMP_DIR=./server/vault-data/tmp

# rclone binary (must be installed and on PATH, or point to an absolute path)
RCLONE_BINARY=rclone

# Google OAuth app (used for the rclone drive remote). Required for OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/drive/oauth/callback

# Secret used to sign session cookies. Must be >= 32 bytes; REQUIRED when
# not bound to loopback. Generate with: openssl rand -hex 32
VAULT_COOKIE_SECRET=change-me-please-use-a-long-random-value

# Mark session cookies Secure (set to true when served over HTTPS)
VAULT_COOKIE_SECURE=false

# Session lifetime (seconds) and max concurrent sessions
VAULT_SESSION_MAX_AGE_SECS=3600
VAULT_SESSION_MAX_COUNT=256

# Resource limits
VAULT_MAX_UPLOAD_BYTES=4294967296
VAULT_MAX_UPLOAD_FILES=200
VAULT_MAX_PREVIEW_BYTES=5242880
